# Google Gemini API (@google/genai)
# Consigue tu API Key en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...tu_api_key_de_gemini

# Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-3.8-flash

# Instrucción de sistema para definir la personalidad del bot
SYSTEM_INSTRUCTION="Eres un asistente virtual profesional, atento y conciso para WhatsApp. Responde de forma clara y directa en español."

# Supabase
# URL de tu proyecto Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key o Secret Key de Supabase para acceso completo al historial
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...tu_secret_key

# Número de mensajes previos de historial que se recuperan para darle memoria al bot
MAX_HISTORY_MESSAGES=10
